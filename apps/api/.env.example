APP_NAME="Smarter Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Une seule langue : le français (courriels, messages, validation).
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# Le fuseau où se comptent les jours et les semaines de l'école (le stockage reste en UTC).
SCHOOL_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# L’adresse de contact écrite au pied de chaque courriel.
MAIL_CONTACT_ADDRESS=contact@smarter-academy.fr

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrateur initial (php artisan db:seed --class=AdminUserSeeder).
# Le seeder est idempotent et ne repose le mot de passe QU'À LA CRÉATION :
# un mot de passe changé depuis /admin/account n'est jamais réécrit.
# Ne committez pas de vraie valeur ici — surchargez-les dans .env.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# Fournisseur de paiement. Secrets d'ENVIRONNEMENT uniquement — jamais en base,
# jamais dans une reponse d'API, jamais dans un journal. Absents, tous les
# webhooks sont refuses (le defaut ferme).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# Offres achetables. La cle INTERNE ('annual') vit dans config/billing.php ;
# seul l'identifiant de tarif Stripe est ici, car il differe entre test et
# production. Le navigateur n'envoie jamais qu'une cle interne.
STRIPE_PRICE_ANNUAL=
# 'test' | 'live'. Encaisser pour de vrai doit etre une decision explicite.
BILLING_MODE=test
BILLING_PROVIDER=stripe
# Paiement en ligne ouvert ? Defaut ferme (plateforme gratuite) ; l'administrateur l'ouvre depuis le tableau de bord.
PAYMENTS_OPEN=false
# Ou le fournisseur renvoie l'eleve. Ces pages ne prouvent AUCUN paiement. Absentes : FRONTEND_URL + /abonnement…
# BILLING_SUCCESS_URL=
# BILLING_CANCEL_URL=
# BILLING_PORTAL_RETURN_URL=

# ─────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────
# Où vit le navigateur de l'élève. Toute redirection vers le site part d'ici
# (vérification d'e-mail, retour de Google) : une URL fournie par le client
# ferait de ces routes une redirection ouverte. En production : https://smarter-academy.fr
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# Documents légaux
# ─────────────────────────────────────────────────────────────────────────
# La version ACCEPTÉE est écrite par le serveur d'après ces valeurs — jamais
# d'après ce que le navigateur annonce. Toute modification de fond des pages
# /cgu ou /confidentialite doit s'accompagner d'une nouvelle date ici, sans
# quoi on change ce que les élèves sont réputés avoir accepté.
LEGAL_TERMS_VERSION=2026-09-12
LEGAL_PRIVACY_VERSION=2026-09-12

# ─────────────────────────────────────────────────────────────────────────
# Google — « Continuer avec Google »
# ─────────────────────────────────────────────────────────────────────────
# STRICTEMENT côté serveur. Il ne doit exister AUCUNE variable VITE_GOOGLE_*
# correspondante : le secret ne doit jamais atteindre le navigateur.
#
# GOOGLE_REDIRECT_URI doit correspondre EXACTEMENT à l'URI autorisée dans la
# console Google (schéma, hôte, port, chemin), sinon Google refuse l'échange.
# En production : https://smarter-academy.fr/api/v1/auth/google/callback
# Registrations (config/registration.php). false = the platform is under test: the sign-up page shows the waiting
# list (an e-mail address, a French phone number optional, read by the admin with the contact messages); existing
# accounts sign in. A student invited by the
# link of his teacher's class still signs up unless REGISTRATION_CLASS_LINKS=false. DEFAULT: closed.
# Since 2026-11-21 these two are only the DEFAULT: the admin opens/closes from « التسجيل » on his dashboard (platform_settings).
REGISTRATION_OPEN=false
REGISTRATION_CLASS_LINKS=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Les origines autorisées à appeler l'API (séparées par des virgules).
# En production : https://smarter-academy.fr, et lui seul. Jamais le domaine
# algérien — les deux produits sont indépendants.
# Défaut local : les ports Vite (5173 dev, 4173 aperçu de production / QA).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Visite guidée des pages (docs/architecture/PAGE_TOURS.md) — facultatif. Vide :
# tout compte élève ou professeur voit la visite guidée de chaque page une fois.
# Une date (AAAA-MM-JJ) : seuls les comptes créés ce jour-là ou après la voient
# d'eux-mêmes ; le bouton de la visite reste ouvert à tous.
TOURS_ELIGIBLE_SINCE=

# ─────────────────────────────────────────────────────────────────────────
# Les fonctions de la plateforme (chaque clé a un défaut dans config/)
# ─────────────────────────────────────────────────────────────────────────
# La librairie (livres papier). Fermée en France : toutes ses routes répondent 404.
BOOKS_ENABLED=false
# Les niveaux fermés en base (grades.is_active) sont refusés. true en production.
CURRICULUM_ENFORCE_ACTIVE_GRADES=true
# Le moteur de maîtrise (2 = Mastery V2) et le recalcul du verdict par le serveur.
MASTERY_ENGINE_VERSION=2
MASTERY_SERVER_EVALUATION=true
# L'ancienne charge {isCorrect, learningPointCodes} : refusée par défaut (les tests l'acceptent).
MASTERY_ACCEPT_LEGACY_EVIDENCE=false
# Le canal de journal de la maîtrise, et sa durée de conservation en jours.
MASTERY_LOG_CHANNEL=mastery
MASTERY_LOG_DAYS=30
# Durée (secondes) du cache des items d'évaluation disponibles.
MASTERY_ITEMS_CACHE_TTL=3600
# La version du texte de partage qu'un élève accepte en rejoignant une classe.
CLASSROOM_CONSENT_VERSION=2026-10-28
# La version du texte « ce que voit ton parent » qu'accepte l'élève.
FAMILY_CONSENT_VERSION=2026-10-22
# L'espace jeux (madar).
MADAR_ENABLED=true
# Le choix adaptatif des exercices ; sans lui, l'ordre de la banque.
PRACTICE_SELECTOR_ENABLED=true
# Les banques d'exercices, la liste des leçons actives et la durée de leur cache (secondes). Absentes : content/practice du dépôt.
# PRACTICE_CONTENT_PATH=
# PRACTICE_ACTIVE_PATH=
PRACTICE_CONTENT_CACHE_TTL=3600
# Le domaine des identifiants générés par un établissement (aucun courriel n'y part). En production : eleve.smarter-academy.fr
SCHOOL_STUDENT_LOGIN_DOMAIN=eleve.smarter-academy.fr
# La fenêtre « récemment » du professeur, en jours.
TEACHER_INSIGHTS_WINDOW_DAYS=14
# Le labo des énigmes : son contenu (absente : content/thinking-lab du dépôt), son cache (secondes), son édition.
# THINKING_LAB_CONTENT_PATH=
THINKING_LAB_CONTENT_CACHE_TTL=3600
THINKING_LAB_EDITION=1
# L'index de « Ma boussole » (absente : content/compass/index.generated.json du dépôt).
# COMPASS_INDEX_PATH=
# Les tests de classe (absente : content/class-tests du dépôt).
# CLASS_TESTS_CONTENT_PATH=
# Notifications Web Push du tableau de bord : `php artisan books:vapid-keys`, une fois, puis dans le .env du serveur. Absentes = désactivées.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@smarter-academy.fr
