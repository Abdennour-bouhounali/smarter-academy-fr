  "statement": {
    "content": "Pour une fête de quartier, un pâtissier range $432$ madeleines et $288$ macarons dans des boîtes identiques, le plus de boîtes possible. Un imprimeur propose trois offres pour les boîtes : offre 1, $0{,}45$ € la boîte ; offre 2, $0{,}30$ € la boîte et $20$ € de frais fixes ; offre 3, $80$ € quel que soit le nombre de boîtes."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Combien de boîtes le pâtissier peut-il préparer, au plus ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        },
        {
          "code": "3e_trouver-le-pgcd_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "144",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le nombre de boîtes divise $432$ et $288$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "On cherche le plus grand diviseur commun."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(432 ; 288) = 144$ boîtes.",
        "incorrect": "Le nombre de boîtes est le plus grand diviseur commun des deux nombres."
      },
      "solution": {
        "lines": [
          "$432 = 288 \\times 1 + 144$ et $288 = 144 \\times 2 + 0$.",
          "$\\text{PGCD}(432 ; 288) = 144$."
        ],
        "result": "144"
      },
