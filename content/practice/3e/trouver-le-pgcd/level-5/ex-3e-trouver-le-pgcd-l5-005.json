    {
      "id": "q2",
      "step": "02",
      "statement": "Calcule $\\text{PGCD}(3\\,131 ; 2\\,323)$ avec l’algorithme d’Euclide, en écrivant les étapes.",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "101",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Divise le plus grand nombre par le plus petit et note le reste."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Recommence avec le diviseur et le reste, jusqu’à obtenir un reste nul."
        }
      ],
      "feedback": {
        "correct": "Le dernier reste non nul est $101$ : $\\text{PGCD}(3\\,131 ; 2\\,323) = 101$.",
        "incorrect": "Le PGCD est le dernier reste non nul : vérifie chaque division et l’endroit où tu t’arrêtes."
      },
      "solution": {
        "lines": [
          "$3\\,131 = 2\\,323 \\times 1 + 808$",
          "$2\\,323 = 808 \\times 2 + 707$",
          "$808 = 707 \\times 1 + 101$",
          "$707 = 101 \\times 7 + 0$",
          "Le dernier reste non nul est $101$, donc $\\text{PGCD}(3\\,131 ; 2\\,323) = 101$."
        ],
        "result": "101"
      },
