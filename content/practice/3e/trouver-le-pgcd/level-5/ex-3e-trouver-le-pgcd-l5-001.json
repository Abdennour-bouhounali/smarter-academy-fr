  "statement": {
    "content": "Une colonie de vacances a reçu $156$ couvertures et $104$ oreillers. On les regroupe tous en paquets identiques, le plus de paquets possible. Une camionnette transporte $20$ paquets au plus par trajet, et un trajet coûte $45$ €."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Combien de paquets peut-on faire, au plus ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P1",
          "role": "primary"
        },
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "52",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Écris la liste des diviseurs de chaque nombre."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Entoure les nombres présents dans les deux listes, puis prends le plus grand."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(156 ; 104) = 52$.",
        "incorrect": "Ce nombre ne divise pas les deux, ou un diviseur commun plus grand existe : relis tes deux listes."
      },
      "solution": {
        "lines": [
          "Le nombre de paquets divise $156$ et $104$.",
          "$156 = 52 \\times 3$ et $104 = 52 \\times 2$, et $3$ et $2$ n’ont pas de diviseur commun autre que $1$.",
          "Donc $\\text{PGCD}(156 ; 104) = 52$ : $52$ paquets au plus."
        ],
        "result": "52"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-PGCD-PAS-LE-PLUS-GRAND",
          "value": "26"
        }
      ],
      "timeSeconds": 60
    },
    {
