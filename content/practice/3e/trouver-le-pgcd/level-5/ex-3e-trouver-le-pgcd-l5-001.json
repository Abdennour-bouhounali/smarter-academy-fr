          "content": "Partage les couvertures entre les paquets."
        }
      ],
      "feedback": {
        "correct": "$156 \\div 52 = 3$ couvertures.",
        "incorrect": "Divise le nombre de couvertures par le nombre de paquets."
      },
      "solution": {
