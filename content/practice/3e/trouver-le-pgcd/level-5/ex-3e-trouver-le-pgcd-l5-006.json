          "id": "h1",
          "type": "look",
          "content": "Quelle valeur de $x$ dépasse $20$ ?"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Partage les bouteilles distribuées entre les équipes."
        }
      ],
      "feedback": {
        "correct": "$x = 30$ et $390 \\div 30 = 13$ bouteilles.",
        "incorrect": "Partage les $390$ bouteilles distribuées, pas les $402$."
      },
      "solution": {
        "lines": [
          "Seule la valeur $x = 30$ dépasse $20$.",
          "$390 \\div 30 = 13$ bouteilles par équipe."
        ],
