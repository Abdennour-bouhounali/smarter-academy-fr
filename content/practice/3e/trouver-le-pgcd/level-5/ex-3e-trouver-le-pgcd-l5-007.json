    },
    {
      "id": "q4",
      "step": "03",
      "statement": "Quel prix, en euros, un sac vide ne doit-il pas dépasser pour que le club reste dans son budget ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "transfer",
      "answerType": "rational",
      "expectedAnswer": "4",
      "answerFormat": "Un nombre entier d’euros",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Retire d’abord le transport du budget."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Partage ce qui reste entre les sacs, puis retire la garniture."
        }
      ],
      "feedback": {
        "correct": "$(570 - 30) \\div 90 = 6$ € par sac, garniture comprise : un sac vide coûte au plus $4$ €.",
        "incorrect": "Pense au transport, payé une seule fois, et à la garniture de chaque sac."
      },
      "solution": {
        "lines": [
          "Sans le transport : $570 - 30 = 540$ €.",
          "Par sac : $540 \\div 90 = 6$ €.",
          "Sans la garniture : $6 - 2 = 4$ €. Un sac vide ne doit pas dépasser $4$ €."
        ],
        "result": "4"
      },
      "timeSeconds": 150
    }
