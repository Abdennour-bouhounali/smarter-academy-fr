          "id": "MISC-PGCD-PAS-LE-PLUS-GRAND",
          "value": "30"
        }
      ],
      "timeSeconds": 60
    },
    {
      "id": "q2",
      "step": "02",
      "sub": "a",
      "lead": "Dans chaque sac :",
      "statement": "combien y a-t-il de compotes ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "4",
      "answerFormat": "Un nombre entier",
      "hints": [
