  "statement": {
    "content": "Pour un camp d’été, un club de randonnée range $360$ compotes et $270$ barres de céréales dans des sacs identiques, le plus de sacs possible, sans rien laisser. Le club paie $2$ € de garniture par sac, et $30$ € de transport quel que soit le nombre de sacs. Il dispose de $570$ €."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Combien de sacs le club peut-il préparer, au plus ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        },
        {
          "code": "3e_trouver-le-pgcd_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "90",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le nombre de sacs divise $360$ et $270$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "On cherche le plus grand diviseur commun."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(360 ; 270) = 90$ sacs.",
        "incorrect": "Le nombre de sacs est le plus grand diviseur commun des deux nombres."
      },
      "solution": {
        "lines": [
          "$360 = 270 \\times 1 + 90$ et $270 = 90 \\times 3 + 0$.",
          "$\\text{PGCD}(360 ; 270) = 90$."
        ],
        "result": "90"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-PGCD-PAS-LE-PLUS-GRAND",
          "value": "45"
        },
