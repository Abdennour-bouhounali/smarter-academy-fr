          "type": "look",
          "content": "Partage les compotes entre les sacs."
        }
      ],
      "feedback": {
        "correct": "$360 \\div 90 = 4$ compotes.",
        "incorrect": "Divise le nombre de compotes par le nombre de sacs."
      },
      "solution": {
        "lines": [
          "$360 \\div 90 = 4$."
        ],
        "result": "4"
      },
      "timeSeconds": 60
    },
    {
