          "type": "look",
          "content": "Partage les $420$ bouteilles entre $14$ familles."
        }
      ],
      "feedback": {
        "correct": "$420 \\div 14 = 30$ bouteilles.",
        "incorrect": "Divise le nombre de bouteilles par $14$."
      },
      "solution": {
        "lines": [
          "$420 \\div 14 = 30$ bouteilles."
        ],
        "result": "30"
      },
      "timeSeconds": 60
    }
