  "statement": {
    "content": "Pour la rentrée, une association de parents a $252$ cahiers et $180$ stylos. Elle veut les répartir tous dans des trousses identiques, le plus de trousses possible. Un cahier coûte $2$ €, un stylo $1$ € et une trousse vide $6$ €. L’association dispose de $950$ €."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Combien de trousses peut-elle préparer, au plus ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        },
        {
          "code": "3e_trouver-le-pgcd_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "36",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le nombre de trousses divise $252$ et $180$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "On cherche le plus grand diviseur commun."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(252 ; 180) = 36$ trousses.",
        "incorrect": "Le nombre de trousses est le plus grand diviseur commun des deux nombres."
      },
      "solution": {
        "lines": [
          "$252 = 2^{2} \\times 3^{2} \\times 7$ et $180 = 2^{2} \\times 3^{2} \\times 5$.",
          "$\\text{PGCD}(252 ; 180) = 2^{2} \\times 3^{2} = 36$."
        ],
        "result": "36"
      },
      "misconceptionSignatures": [
