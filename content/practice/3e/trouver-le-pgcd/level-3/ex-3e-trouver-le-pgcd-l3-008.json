  "statement": {
    "content": "Un atelier découpe une plaque de métal rectangulaire de $2{,}40$ m sur $1{,}80$ m en carrés identiques, les plus grands possibles, sans perte. Le côté d’un carré est un nombre entier de centimètres."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Calcule $\\text{PGCD}(240 ; 180)$.",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "60",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Écris la liste des diviseurs de chaque nombre."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Entoure les nombres présents dans les deux listes, puis prends le plus grand."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(240 ; 180) = 60$.",
        "incorrect": "Ce nombre ne divise pas les deux, ou un diviseur commun plus grand existe : relis tes deux listes."
      },
      "solution": {
        "lines": [
          "$240 = 60 \\times 4$ et $180 = 60 \\times 3$, et $4$ et $3$ n’ont pas de diviseur commun autre que $1$.",
          "Donc $\\text{PGCD}(240 ; 180) = 60$."
        ],
        "result": "60"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-PGCD-PAS-LE-PLUS-GRAND",
          "value": "30"
        }
      ],
      "timeSeconds": 60
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "Quelle est la longueur, en centimètres, du côté d’un carré ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "60",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Convertis les dimensions en centimètres."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Le côté divise les deux dimensions et il est le plus grand possible."
        }
      ],
      "feedback": {
        "correct": "Le côté mesure $60$ cm.",
        "incorrect": "Le côté est le plus grand diviseur commun des deux dimensions."
      },
      "solution": {
        "lines": [
          "$2{,}40$ m $= 240$ cm et $1{,}80$ m $= 180$ cm.",
          "Le côté mesure $\\text{PGCD}(240 ; 180) = 60$ cm."
        ],
        "result": "60"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-PGCD-PAS-LE-PLUS-GRAND",
          "value": "30"
        },
        {
          "id": "MISC-PGCD-PAS-LE-PLUS-GRAND",
          "value": "20"
        }
      ],
      "timeSeconds": 60
    },
    {
      "id": "q3",
      "step": "03",
      "statement": "Combien de carrés obtient-on ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "transfer",
      "answerType": "rational",
      "expectedAnswer": "12",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Combien de carrés tiennent sur chaque côté ?"
        }
      ],
      "feedback": {
        "correct": "$4$ carrés sur la longueur et $3$ sur la largeur : $12$ carrés.",
        "incorrect": "Divise chaque dimension par le côté d’un carré, puis multiplie."
      },
      "solution": {
        "lines": [
          "$240 \\div 60 = 4$ et $180 \\div 60 = 3$.",
          "On obtient $4 \\times 3 = 12$ carrés."
        ],
        "result": "12"
      },
      "misconceptionSignatures": [
