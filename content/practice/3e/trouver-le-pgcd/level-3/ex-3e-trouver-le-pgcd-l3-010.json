  "statement": {
    "content": "Un comité départemental de football a reçu $276$ maillots et $207$ shorts. Il veut les distribuer tous à des clubs en lots identiques : chaque club reçoit le même nombre de maillots et le même nombre de shorts, et rien ne reste."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Quel est le plus grand nombre de clubs qui peuvent recevoir un lot ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P4",
          "role": "primary"
        },
        {
          "code": "3e_trouver-le-pgcd_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "69",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le nombre de clubs doit diviser $276$ et $207$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "On cherche le plus grand de ces diviseurs communs."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(276 ; 207) = 69$ : $69$ clubs au plus.",
        "incorrect": "Le nombre de clubs est un diviseur commun des deux nombres, le plus grand."
      },
      "solution": {
        "lines": [
          "$276 = 2^{2} \\times 3 \\times 23$ et $207 = 3^{2} \\times 23$.",
          "$\\text{PGCD}(276 ; 207) = 3 \\times 23 = 69$.",
          "Au plus $69$ clubs reçoivent un lot."
        ],
        "result": "69"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-PGCD-PAS-LE-PLUS-GRAND",
          "value": "23"
        }
      ],
      "timeSeconds": 150
    },
