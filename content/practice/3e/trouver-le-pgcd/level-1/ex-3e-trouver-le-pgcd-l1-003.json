    {
      "id": "q2",
      "step": "02",
      "statement": "Quel est le plus grand diviseur commun de $63$ et $49$, c’est-à-dire $\\text{PGCD}(63 ; 49)$ ?",
      "learningPoints": [
        {
          "code": "3e_trouver-le-pgcd_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
