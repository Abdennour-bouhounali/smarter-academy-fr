      "feedback": {
        "correct": "$EF = k \\times BC = 0{,}25 \\times 36 = 9$ cm.",
        "incorrect": "Vérifie le côté homologue que tu utilises, et si tu multiplies ou si tu divises par $k$."
      },
      "solution": {
        "lines": [
          "$[EF]$ est l’homologue de $[BC]$.",
          "$EF = k \\times BC = 0{,}25 \\times 36 = 9$ cm."
