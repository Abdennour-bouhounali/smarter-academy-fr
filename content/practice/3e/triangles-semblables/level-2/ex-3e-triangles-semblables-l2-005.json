    {
      "id": "q2",
      "step": "02",
      "statement": "Le triangle $DEF$ est-il un agrandissement ou une réduction du triangle $ABC$ ? Justifie avec $k$.",
      "learningPoints": [
        {
          "code": "3e_triangles-semblables_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "Une réduction, car $k < 1$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "Un agrandissement, car $k < 1$",
          "isCorrect": false,
          "misconceptionId": "MISC-SEMB-K-INVERSE"
        },
        {
          "id": "C",
          "content": "Une réduction, car $DEF$ est dessiné plus petit",
          "isCorrect": false,
          "misconceptionId": "MISC-SEMB-MEME-TAILLE"
        },
        {
          "id": "D",
          "content": "Un agrandissement, car $k = \\dfrac{1}{4}$ est positif",
          "isCorrect": false,
          "misconceptionId": "MISC-SEMB-K-INVERSE"
        }
      ],
      "answerFormat": "Choisis une réponse",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Compare $k$ à 1."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Si $k$ est plus petit que 1, les longueurs sont multipliées par un nombre plus petit que 1."
        }
      ],
      "feedback": {
        "correct": "Comme $\\dfrac{1}{4} < 1$, chaque longueur de $DEF$ est plus petite que celle de $ABC$ : c’est une réduction.",
        "incorrect": "Le dessin n’est pas à l’échelle : c’est la valeur de $k$ qui décide, comparée à 1."
      },
      "solution": {
        "lines": [
          "$k = \\dfrac{1}{4}$ et $1 < 4$, donc $k < 1$.",
          "Les longueurs sont multipliées par un nombre inférieur à 1 : $DEF$ est une réduction de $ABC$."
        ]
      },
