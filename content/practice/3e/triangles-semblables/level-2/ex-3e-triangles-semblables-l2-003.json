      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "16",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin, en cm",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le côté homologue de $[LM]$ est $[FG]$ : sa longueur est connue."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Multiplie la longueur de $[FG]$ par $k$."
        }
      ],
      "feedback": {
        "correct": "$LM = k \\times FG = 0{,}8 \\times 20 = 16$ cm.",
        "incorrect": "Vérifie le côté homologue que tu utilises, et si tu multiplies ou si tu divises par $k$."
      },
      "solution": {
        "lines": [
          "$[LM]$ est l’homologue de $[FG]$.",
          "$LM = k \\times FG = 0{,}8 \\times 20 = 16$ cm."
        ],
        "result": "LM = 16"
      },
