  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Calcule le coefficient $k$ qui transforme $EFG$ en $KLM$.",
      "learningPoints": [
        {
          "code": "3e_triangles-semblables_P4",
          "role": "primary"
        },
        {
          "code": "3e_triangles-semblables_P3",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "0,8",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Cherche deux côtés homologues dont tu connais les deux longueurs : $[EF]$ et $[KL]$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Le coefficient s’obtient en divisant une longueur de $KLM$ par la longueur homologue de $EFG$."
        }
      ],
      "feedback": {
        "correct": "$k = \\dfrac{KL}{EF} = \\dfrac{12}{15} = 0{,}8$.",
        "incorrect": "Divise la longueur du côté de $KLM$ par celle de son homologue dans $EFG$, et pas l’inverse."
      },
      "solution": {
        "lines": [
          "Les côtés $[EF]$ et $[KL]$ sont homologues.",
          "$k = \\dfrac{KL}{EF} = \\dfrac{12}{15} = 0{,}8$."
        ],
        "result": "k = 0{,}8"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-SEMB-K-INVERSE",
          "value": "1,25"
        }
      ],
      "timeSeconds": 100
    },
    {
