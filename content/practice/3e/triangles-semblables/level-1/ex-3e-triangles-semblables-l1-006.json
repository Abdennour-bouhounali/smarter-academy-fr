  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Le triangle $DEF$ est-il un agrandissement ou une réduction du triangle $ABC$ ?",
      "learningPoints": [
        {
          "code": "3e_triangles-semblables_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "Un agrandissement, car $k > 1$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "Une réduction, car $k > 1$",
          "isCorrect": false,
          "misconceptionId": "MISC-SEMB-K-INVERSE"
        },
        {
          "id": "C",
          "content": "Un agrandissement, car les deux triangles ont la même forme",
          "isCorrect": false,
          "misconceptionId": "MISC-SEMB-MEME-TAILLE"
        },
        {
          "id": "D",
          "content": "Une réduction, car le dénominateur $4$ est plus petit que $5$",
          "isCorrect": false,
          "misconceptionId": "MISC-SEMB-K-INVERSE"
        }
      ],
      "answerFormat": "Choisis une réponse",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Compare $k$ à 1."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Si $k$ est plus grand que 1, les longueurs sont multipliées par un nombre plus grand que 1."
        }
      ],
      "feedback": {
        "correct": "Comme $\\dfrac{5}{4} > 1$, chaque longueur de $DEF$ est plus grande que celle de $ABC$ : c’est un agrandissement.",
        "incorrect": "Le coefficient $k$ multiplie les longueurs de $ABC$ : s’il dépasse 1, les longueurs augmentent."
      },
      "solution": {
        "lines": [
          "$k = \\dfrac{5}{4}$ et $5 > 4$, donc $k > 1$.",
          "Les longueurs sont multipliées par un nombre supérieur à 1 : $DEF$ est un agrandissement de $ABC$."
        ]
      },
      "timeSeconds": 90
    },
