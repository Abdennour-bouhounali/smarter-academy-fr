  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Calcule le coefficient $k$ qui transforme $ABC$ en $DEF$.",
      "learningPoints": [
        {
          "code": "3e_triangles-semblables_P4",
          "role": "primary"
        },
        {
          "code": "3e_triangles-semblables_P3",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "0,75",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Cherche deux côtés homologues dont tu connais les deux longueurs : $[AB]$ et $[DE]$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Le coefficient s’obtient en divisant une longueur de $DEF$ par la longueur homologue de $ABC$."
        }
      ],
      "feedback": {
        "correct": "$k = \\dfrac{DE}{AB} = \\dfrac{10{,}5}{14} = 0{,}75$.",
        "incorrect": "Divise la longueur du côté de $DEF$ par celle de son homologue dans $ABC$, et pas l’inverse."
      },
      "solution": {
        "lines": [
          "Les côtés $[AB]$ et $[DE]$ sont homologues.",
          "$k = \\dfrac{DE}{AB} = \\dfrac{10{,}5}{14} = 0{,}75$."
        ],
        "result": "k = 0{,}75"
      },
      "misconceptionSignatures": [
