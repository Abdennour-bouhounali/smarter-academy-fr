  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Calcule le coefficient $k$ qui transforme $ABC$ en $DEF$.",
      "learningPoints": [
        {
          "code": "3e_triangles-semblables_P4",
          "role": "primary"
        },
        {
          "code": "3e_triangles-semblables_P3",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "3,5",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Cherche deux côtés homologues dont tu connais les deux longueurs : $[AB]$ et $[DE]$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Le coefficient s’obtient en divisant une longueur de $DEF$ par la longueur homologue de $ABC$."
        }
      ],
      "feedback": {
        "correct": "$k = \\dfrac{DE}{AB} = \\dfrac{11{,}2}{3{,}2} = 3{,}5$.",
        "incorrect": "Divise la longueur du côté de $DEF$ par celle de son homologue dans $ABC$, et pas l’inverse."
      },
      "solution": {
        "lines": [
          "Les côtés $[AB]$ et $[DE]$ sont homologues.",
          "$k = \\dfrac{DE}{AB} = \\dfrac{11{,}2}{3{,}2} = 3{,}5$."
        ],
        "result": "k = 3{,}5"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-SEMB-K-INVERSE",
          "value": "2/7"
        }
      ],
      "timeSeconds": 100
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "Calcule la hauteur $EF$ du château d’eau.",
      "learningPoints": [
        {
          "code": "3e_triangles-semblables_P4",
          "role": "primary"
        },
        {
          "code": "3e_triangles-semblables_P3",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "8,4",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin, en m",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le côté homologue de $[EF]$ est $[BC]$ : sa longueur est connue."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Multiplie la longueur de $[BC]$ par $k$."
        }
      ],
      "feedback": {
        "correct": "$EF = k \\times BC = 3{,}5 \\times 2{,}4 = 8{,}4$ m.",
        "incorrect": "Vérifie le côté homologue que tu utilises, et si tu multiplies ou si tu divises par $k$."
      },
      "solution": {
        "lines": [
          "$[EF]$ est l’homologue de $[BC]$.",
          "$EF = k \\times BC = 3{,}5 \\times 2{,}4 = 8{,}4$ m."
        ],
        "result": "EF = 8{,}4"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-SEMB-K-INVERSE",
          "value": "24/35"
        }
      ],
      "timeSeconds": 110
    },
    {
