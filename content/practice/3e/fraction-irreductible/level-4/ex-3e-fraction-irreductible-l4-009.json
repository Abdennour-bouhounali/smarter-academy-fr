        "requiredForm": "irreducible"
      },
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Décompose le numérateur et le dénominateur en facteurs premiers."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Simplifie les facteurs premiers qui figurent dans les deux décompositions."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{945}{1\\,575} = \\dfrac{3}{5}$, et cette fraction est irréductible.",
        "incorrect": "Vérifie que tu as simplifié par tous les facteurs premiers communs, et seulement par ceux-là.",
        "notIrreducible": "Ta fraction est égale à la bonne, mais elle peut encore se simplifier : cherche un facteur premier commun aux deux termes."
      },
      "solution": {
