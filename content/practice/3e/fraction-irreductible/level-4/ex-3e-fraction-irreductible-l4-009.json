        {
          "id": "h2",
          "type": "direction",
          "content": "Multiplie les facteurs premiers communs, chacun avec le plus petit exposant."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(225 ; 1\\,575) = 225$.",
        "incorrect": "Ce nombre ne divise pas les deux, ou un diviseur commun plus grand existe : reprends les décompositions."
