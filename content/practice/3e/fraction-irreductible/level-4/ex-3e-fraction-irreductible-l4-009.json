  "statement": {
    "content": "Une bibliothèque municipale a prêté $1\\,575$ documents en un mois : $945$ livres, $225$ DVD, les autres sont des magazines."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Quelle fraction des documents représentent les livres ? Donne-la sous forme irréductible, en décomposant en facteurs premiers.",
      "learningPoints": [
        {
          "code": "3e_fraction-irreductible_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "Une fraction irréductible, écrite a/b",
      "expectedAnswer": "3/5",
