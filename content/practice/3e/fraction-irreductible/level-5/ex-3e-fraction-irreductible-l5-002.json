    {
      "id": "q3",
      "step": "03",
      "statement": "Pour un autre chantier, il utilise $12$ L de peinture jaune, avec le même rapport entre le jaune et le bleu. Combien de litres de peinture bleue mélange-t-il ?",
      "learningPoints": [
        {
          "code": "3e_fraction-irreductible_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "Un nombre de litres entier",
      "expectedAnswer": "8",
      "counted": false,
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Utilise la fraction irréductible trouvée plus haut."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Combien de litres représente une part de jaune ?"
        }
      ],
      "feedback": {
        "correct": "Il faut $8$ L de bleu pour $12$ L de jaune.",
        "incorrect": "Reprends le calcul avec les données de l’énoncé."
      },
      "solution": {
        "lines": [
          "Le rapport jaune sur bleu est $\\dfrac{3}{2}$ : le jaune est $3$ parts et le bleu $2$ parts.",
          "$12 \\div 3 = 4$ L par part, donc $4 \\times 2 = 8$ L de bleu."
        ],
        "result": "8"
      },
      "timeSeconds": 75
