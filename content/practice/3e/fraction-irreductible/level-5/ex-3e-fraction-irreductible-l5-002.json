  "statement": {
    "content": "Pour repeindre le préau de l’école, un peintre mélange $1\\,188$ mL de peinture jaune et $792$ mL de peinture bleue."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Détermine $\\text{PGCD}(1\\,188 ; 792)$.",
      "learningPoints": [
        {
          "code": "3e_fraction-irreductible_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "396",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Décompose les deux nombres en facteurs premiers."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Multiplie les facteurs premiers communs, chacun avec le plus petit exposant."
        }
      ],
      "feedback": {
        "correct": "$\\text{PGCD}(1\\,188 ; 792) = 396$.",
        "incorrect": "Ce nombre ne divise pas les deux, ou un diviseur commun plus grand existe : reprends les décompositions."
      },
      "solution": {
        "lines": [
          "$1\\,188 = 2 \\times 2 \\times 3 \\times 3 \\times 3 \\times 11$",
          "$792 = 2 \\times 2 \\times 2 \\times 3 \\times 3 \\times 11$",
          "Les facteurs premiers communs : $2 \\times 2 \\times 3 \\times 3 \\times 11 = 396$."
        ],
        "result": "396"
      },
      "timeSeconds": 75
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "Écris la fraction $\\dfrac{1\\,188}{792}$ (quantité de jaune sur quantité de bleu) sous forme irréductible, en divisant par ce PGCD.",
      "learningPoints": [
        {
          "code": "3e_fraction-irreductible_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "Une fraction irréductible, écrite a/b",
      "expectedAnswer": "3/2",
      "evaluationPolicy": {
        "requiredForm": "irreducible"
      },
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Cherche d’abord le PGCD du numérateur et du dénominateur."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Divise le numérateur et le dénominateur par ce PGCD."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{1\\,188}{792} = \\dfrac{3}{2}$, et cette fraction est irréductible.",
        "incorrect": "Vérifie que tu as simplifié par tous les facteurs premiers communs, et seulement par ceux-là.",
        "notIrreducible": "Ta fraction est égale à la bonne, mais elle peut encore se simplifier : cherche un facteur premier commun aux deux termes."
      },
      "solution": {
        "lines": [
          "$1\\,188 = 2 \\times 2 \\times 3 \\times 3 \\times 3 \\times 11$ et $792 = 2 \\times 2 \\times 2 \\times 3 \\times 3 \\times 11$, donc $\\text{PGCD}(1\\,188 ; 792) = 396$.",
          "$1\\,188 \\div 396 = 3$ et $792 \\div 396 = 2$.",
          "$\\dfrac{1\\,188}{792} = \\dfrac{3}{2}$."
        ],
        "result": "\\dfrac{1\\,188}{792} = \\dfrac{3}{2}"
      },
