    {
      "id": "q2",
      "step": "02",
      "statement": "On donne $OA = 2$ cm, $AE = 5$ cm et $AB = 1{,}8$ cm. Emma calcule $EF = \\dfrac{1{,}8 \\times 5}{2}$. Calcule la bonne valeur de $EF$.",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P2",
          "role": "primary"
        },
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "2,7",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin, en cm",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Repère les deux droites sécantes et les deux droites parallèles."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Commence par la longueur qui part de $O$ sur la droite $(AE)$."
        }
      ],
      "feedback": {
        "correct": "$EF = \\dfrac{1{,}8 \\times 3}{2} = 2{,}7$ cm.",
        "incorrect": "Relis ton égalité : chaque longueur part du point d’intersection, et chaque rapport réunit deux longueurs portées par la même droite, dans le même ordre."
      },
      "solution": {
        "lines": [
          "$O$ est entre $A$ et $E$ : $OE = AE - OA = 5 - 2 = 3$ cm.",
          "$\\dfrac{OA}{OE} = \\dfrac{AB}{EF}$, donc $\\dfrac{2}{3} = \\dfrac{1{,}8}{EF}$.",
          "$EF = \\dfrac{1{,}8 \\times 3}{2} = 2{,}7$ cm."
        ],
        "result": "EF = 2{,}7"
      },
