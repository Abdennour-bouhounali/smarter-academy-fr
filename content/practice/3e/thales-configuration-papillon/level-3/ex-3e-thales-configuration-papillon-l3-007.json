      "feedback": {
        "correct": "$AD = BC = 3$, donc $MD = 3 - 2 = 1$.",
        "incorrect": "Calcule d’abord $AD$, puis enlève le morceau $AM$."
      },
      "solution": {
        "lines": [
          "$ABCD$ est un parallélogramme : $AD = BC = 3$.",
          "$M \\in [AD]$ : $MD = AD - AM = 3 - 2 = 1$."
        ],
        "result": "MD = 1"
      },
