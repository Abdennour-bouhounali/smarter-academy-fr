    {
      "id": "q2",
      "step": "02",
      "statement": "Calcule $DN$.",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "primary"
        },
        {
          "code": "3e_thales-configuration-papillon_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "2,5",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Repère les deux droites sécantes et les deux droites parallèles."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Écris l’égalité des trois rapports, puis garde celle qui contient $DN$ et trois longueurs connues."
        }
      ],
      "feedback": {
        "correct": "$DN = \\dfrac{1 \\times 5}{2} = 2{,}5$.",
        "incorrect": "Relis ton égalité : chaque longueur part du point d’intersection, et chaque rapport réunit deux longueurs portées par la même droite, dans le même ordre."
      },
      "solution": {
        "lines": [
          "$(DC) \\parallel (AB)$ car $ABCD$ est un parallélogramme, et $N \\in (DC)$ : $(DN) \\parallel (AB)$.",
          "Les points $A$, $M$, $D$ sont alignés, ainsi que les points $B$, $M$, $N$.",
          "D’après le théorème de Thalès : $\\dfrac{MD}{MA} = \\dfrac{MN}{MB} = \\dfrac{DN}{AB}$.",
          "$\\dfrac{MD}{MA} = \\dfrac{DN}{AB}$, donc $\\dfrac{1}{2} = \\dfrac{DN}{5}$.",
          "$DN = \\dfrac{1 \\times 5}{2} = 2{,}5$."
        ],
        "result": "DN = 2{,}5"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-THALES-RAPPORT-INVERSE",
          "value": "10"
        }
      ],
      "timeSeconds": 150
    },
