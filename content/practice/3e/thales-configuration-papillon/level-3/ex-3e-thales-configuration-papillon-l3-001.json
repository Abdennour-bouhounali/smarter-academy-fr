      "answerType": "rational",
      "expectedAnswer": "6",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin, en cm",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Repère les deux droites sécantes et les deux droites parallèles."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Écris l’égalité des trois rapports, puis garde celle qui contient $HG$ et trois longueurs connues."
        }
      ],
      "feedback": {
        "correct": "$HG = \\dfrac{2 \\times 3{,}9}{1{,}3} = 6$ cm.",
        "incorrect": "Relis ton égalité : chaque longueur part du point d’intersection, et chaque rapport réunit deux longueurs portées par la même droite, dans le même ordre."
      },
      "solution": {
        "lines": [
          "$\\dfrac{OE}{OH} = \\dfrac{EF}{HG}$, donc $\\dfrac{1{,}3}{3{,}9} = \\dfrac{2}{HG}$.",
          "$HG = \\dfrac{2 \\times 3{,}9}{1{,}3} = 6$ cm."
        ],
        "result": "HG = 6"
