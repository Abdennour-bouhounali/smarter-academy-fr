  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Quelle est la valeur du rapport $\\dfrac{OL}{OQ}$ ?",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "2/3",
      "answerFormat": "Une fraction, comme 3/4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Repère le point où les deux droites se coupent, et les deux droites parallèles."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Le rapport $\\dfrac{OL}{OQ}$ est égal à un autre rapport dont tu connais les deux longueurs."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{OL}{OQ} = \\dfrac{OK}{OP} = \\dfrac{2}{3}$.",
        "incorrect": "Cherche le rapport égal à $\\dfrac{OL}{OQ}$ : les deux longueurs sur la droite $(KP)$, dans le même ordre."
      },
      "solution": {
        "lines": [
          "Les points $K$, $O$, $P$ sont alignés, ainsi que les points $L$, $O$, $Q$ ; les droites $(KL)$ et $(PQ)$ sont parallèles (données).",
          "D’après le théorème de Thalès : $\\dfrac{OK}{OP} = \\dfrac{OL}{OQ} = \\dfrac{KL}{PQ}$.",
          "Donc $\\dfrac{OL}{OQ} = \\dfrac{OK}{OP} = \\dfrac{2}{3}$."
        ],
        "result": "\\dfrac{OL}{OQ} = \\dfrac{2}{3}"
      },
      "misconceptionSignatures": [
