      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "3,6",
      "answerFormat": "Un nombre décimal, avec une virgule si besoin, en cm",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Repère les deux droites sécantes et les deux droites parallèles."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Écris l’égalité des trois rapports, puis garde celle qui contient $PQ$ et trois longueurs connues."
        }
      ],
      "feedback": {
        "correct": "$PQ = \\dfrac{2{,}4 \\times 3}{2} = 3{,}6$ cm.",
        "incorrect": "Relis ton égalité : chaque longueur part du point d’intersection, et chaque rapport réunit deux longueurs portées par la même droite, dans le même ordre."
      },
      "solution": {
        "lines": [
          "$\\dfrac{OK}{OP} = \\dfrac{OL}{OQ} = \\dfrac{KL}{PQ}$ (question 1).",
          "$\\dfrac{OK}{OP} = \\dfrac{KL}{PQ}$, donc $\\dfrac{2}{3} = \\dfrac{2{,}4}{PQ}$.",
          "$PQ = \\dfrac{2{,}4 \\times 3}{2} = 3{,}6$ cm."
        ],
        "result": "PQ = 3{,}6"
