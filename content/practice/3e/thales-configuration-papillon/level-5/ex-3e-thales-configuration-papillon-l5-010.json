        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "0,26",
      "answerFormat": "Un nombre décimal, en m",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le pied $[AD]$ traverse $O$ : $AD = OA + OD$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$OD$ vaut $2{,}5$ fois $OA$ : combien de fois $OA$ dans tout le pied ?"
        }
      ],
      "feedback": {
        "correct": "$AD = OA + 2{,}5 \\times OA = 3{,}5 \\times OA$, donc $OA = \\dfrac{0{,}91}{3{,}5} = 0{,}26$ m.",
        "incorrect": "$AD = OA + OD$ et $OD = 2{,}5 \\times OA$ : le pied mesure $3{,}5$ fois $OA$."
      },
      "solution": {
        "lines": [
          "$OD = 2{,}5 \\times OA$, donc $AD = OA + OD = 3{,}5 \\times OA$.",
          "$OA = \\dfrac{0{,}91}{3{,}5} = 0{,}26$ m."
        ],
        "result": "OA = 0{,}26"
      },
      "misconceptionSignatures": [
