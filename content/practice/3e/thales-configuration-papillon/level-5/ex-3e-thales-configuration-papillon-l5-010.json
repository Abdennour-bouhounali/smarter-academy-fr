  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Quelle est la valeur du rapport $\\dfrac{OD}{OA}$ ?",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "primary"
        },
        {
          "code": "3e_thales-configuration-papillon_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "2,5",
      "answerFormat": "Un nombre décimal ou une fraction",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Les droites $(AD)$ et $(BC)$ se coupent en $O$, et $(AB) \\parallel (DC)$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Ce rapport est égal au rapport de deux écartements, dans le même ordre."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{OD}{OA} = \\dfrac{DC}{AB} = \\dfrac{0{,}75}{0{,}3} = 2{,}5$.",
        "incorrect": "Écris l’égalité des trois rapports dans les triangles $ODC$ et $OAB$."
      },
      "solution": {
        "lines": [
          "D’après le théorème de Thalès : $\\dfrac{OD}{OA} = \\dfrac{OC}{OB} = \\dfrac{DC}{AB}$.",
          "$\\dfrac{OD}{OA} = \\dfrac{0{,}75}{0{,}3} = 2{,}5$."
        ],
        "result": "\\dfrac{OD}{OA} = 2{,}5"
      },
      "misconceptionSignatures": [
        {
          "id": "MISC-THALES-RAPPORT-INVERSE",
          "value": "0,4"
        }
      ],
      "timeSeconds": 120
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "Calcule $OA$.",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "primary"
        },
        {
          "code": "3e_thales-configuration-papillon_P2",
