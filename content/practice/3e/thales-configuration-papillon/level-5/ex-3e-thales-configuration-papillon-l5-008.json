  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Calcule l’écartement $DC$ des pieds des mâts sur le sol.",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "primary"
