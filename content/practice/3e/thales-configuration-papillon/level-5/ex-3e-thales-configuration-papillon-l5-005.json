      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "5",
      "answerFormat": "Un nombre, en m",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Cette fois, l’inconnue est $OE$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Écris $\\dfrac{OA}{OE} = \\dfrac{AB}{EF}$ avec $EF$ en centimètres."
        }
      ],
      "feedback": {
        "correct": "$OE = \\dfrac{9 \\times 200}{3{,}6} = 500$ cm, soit $5$ m.",
        "incorrect": "Convertis $2$ m en centimètres, puis $\\dfrac{OA}{OE} = \\dfrac{AB}{EF}$."
      },
      "solution": {
        "lines": [
          "$EF = 2$ m $= 200$ cm.",
          "$\\dfrac{9}{OE} = \\dfrac{3{,}6}{200}$, donc $OE = \\dfrac{9 \\times 200}{3{,}6} = 500$ cm $= 5$ m."
        ],
        "result": "OE = 5\\text{ m}"
      },
