  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "L’écran est à $4$ m de la lentille. Quelle est la hauteur $EF$ de l’image sur l’écran, en mètres ?",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "primary"
        },
        {
          "code": "3e_thales-configuration-papillon_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "1,6",
      "answerFormat": "Un nombre décimal, en m",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Écris toutes les longueurs dans la même unité."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Écris l’égalité de Thalès dans les triangles $OAB$ et $OEF$, et garde celle qui contient $EF$."
        }
      ],
      "feedback": {
        "correct": "$EF = \\dfrac{3{,}6 \\times 400}{9} = 160$ cm, soit $1{,}6$ m.",
        "incorrect": "$4$ m $= 400$ cm ; puis $\\dfrac{OA}{OE} = \\dfrac{AB}{EF}$."
      },
      "solution": {
        "lines": [
          "$OE = 4$ m $= 400$ cm.",
          "D’après le théorème de Thalès : $\\dfrac{OA}{OE} = \\dfrac{OB}{OF} = \\dfrac{AB}{EF}$.",
          "$\\dfrac{9}{400} = \\dfrac{3{,}6}{EF}$, donc $EF = \\dfrac{3{,}6 \\times 400}{9} = 160$ cm $= 1{,}6$ m."
        ],
        "result": "EF = 1{,}6\\text{ m}"
      },
      "misconceptionSignatures": [
