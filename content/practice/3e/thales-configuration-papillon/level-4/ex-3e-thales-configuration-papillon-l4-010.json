  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Les droites $(AB)$ et $(DC)$ sont parallèles. Quelle est la valeur du rapport $\\dfrac{OA}{OC}$ ?",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P1",
          "role": "primary"
        },
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "2/3",
      "answerFormat": "Une fraction, comme 3/4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Les droites $(AC)$ et $(BD)$ se coupent en $O$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Le rapport $\\dfrac{OA}{OC}$ est égal au rapport des hauteurs des poteaux, dans le même ordre."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{OA}{OC} = \\dfrac{AB}{CD} = \\dfrac{3{,}2}{4{,}8} = \\dfrac{2}{3}$.",
        "incorrect": "Écris l’égalité des trois rapports dans les triangles $OAB$ et $OCD$."
      },
      "solution": {
        "lines": [
          "$(AB) \\parallel (DC)$ : deux droites verticales.",
          "Les points $A$, $O$, $C$ sont alignés, ainsi que $B$, $O$, $D$.",
          "D’après le théorème de Thalès : $\\dfrac{OA}{OC} = \\dfrac{OB}{OD} = \\dfrac{AB}{CD} = \\dfrac{3{,}2}{4{,}8} = \\dfrac{2}{3}$."
        ],
        "result": "\\dfrac{OA}{OC} = \\dfrac{2}{3}"
      },
