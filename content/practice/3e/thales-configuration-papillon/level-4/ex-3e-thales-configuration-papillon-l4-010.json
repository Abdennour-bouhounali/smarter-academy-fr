          "content": "Le câble $[AC]$ traverse le point $O$ : $AC = OA + OC$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$OA$ représente $2$ parts et $OC$ en représente $3$."
        }
      ],
      "feedback": {
        "correct": "$OA = \\dfrac{2}{5} \\times 12 = 4{,}8$ m.",
        "incorrect": "$OA$ et $OC$ sont dans le rapport $\\dfrac{2}{3}$ ET leur somme est $12$ m."
      },
      "solution": {
        "lines": [
          "$\\dfrac{OA}{OC} = \\dfrac{2}{3}$ : $OA$ fait $2$ parts, $OC$ en fait $3$, et $AC = 5$ parts $= 12$ m.",
          "$OA = \\dfrac{2}{5} \\times 12 = 4{,}8$ m."
        ],
        "result": "OA = 4{,}8"
