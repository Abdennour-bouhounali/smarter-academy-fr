    {
      "id": "q3",
      "step": "03",
      "statement": "Un atelier fabrique $25$ tables de ce modèle. Quelle longueur de bois faut-il pour tous les pieds, en mètres ?",
      "learningPoints": [
        {
          "code": "3e_thales-configuration-papillon_P3",
          "role": "primary"
        },
        {
          "code": "3e_thales-configuration-papillon_P2",
