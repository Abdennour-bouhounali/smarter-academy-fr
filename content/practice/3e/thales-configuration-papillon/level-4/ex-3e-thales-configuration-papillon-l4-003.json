        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "35",
      "answerFormat": "Un nombre, en m",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Un pied va d’un bout à l’autre en passant par $O$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Calcule $AD$ et $BC$, puis la longueur pour une table."
        }
      ],
      "feedback": {
        "correct": "$25 \\times (80{,}5 + 59{,}5) = 3\\,500$ cm, soit $35$ m.",
        "incorrect": "Chaque pied traverse $O$ : $AD = OA + OD$ et $BC = OB + OC$. Puis multiplie par $25$ et convertis en mètres."
      },
      "solution": {
        "lines": [
          "$AD = OA + OD = 32{,}2 + 48{,}3 = 80{,}5$ cm et $BC = OB + OC = 23{,}8 + 35{,}7 = 59{,}5$ cm.",
          "Pour une table : $80{,}5 + 59{,}5 = 140$ cm.",
          "Pour $25$ tables : $25 \\times 140 = 3\\,500$ cm, soit $35$ m."
        ],
        "result": "35\\text{ m}"
