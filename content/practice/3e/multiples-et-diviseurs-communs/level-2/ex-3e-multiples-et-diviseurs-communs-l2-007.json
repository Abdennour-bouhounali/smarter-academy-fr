  "statement": {
    "content": "Deux roues dentées s’engrènent : l’une a $6$ dents, l’autre $10$. On colle un repère sur une dent de chaque roue ; au départ, les deux repères sont face à face."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Combien de dents ont défilé quand les deux repères sont de nouveau face à face pour la première fois ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "30",
      "answerFormat": "Un nombre de dents",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le nombre de dents qui ont défilé est un multiple de $6$ ET de $10$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "On cherche le plus petit multiple commun non nul."
        }
      ],
      "feedback": {
        "correct": "$30$ est le plus petit multiple commun non nul de $6$ et de $10$.",
        "incorrect": "Le nombre de dents défilées est un multiple de chacun des deux nombres de dents : cherche le plus petit."
      },
      "solution": {
        "lines": [
          "Multiples de $10$ : $10$, $20$, $30$.",
          "$30$ = $6$ × $5$."
        ],
        "result": "30"
      },
