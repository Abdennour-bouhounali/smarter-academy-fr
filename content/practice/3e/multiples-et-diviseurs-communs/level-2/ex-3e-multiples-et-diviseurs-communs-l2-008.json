      "feedback": {
        "correct": "$30$ est un multiple de $6$ et de $15$.",
        "incorrect": "Écris les multiples de $15$ et cherche le premier qui est dans la table de $6$."
      },
      "solution": {
        "lines": [
          "Multiples de $15$ : $15$, $30$.",
          "$15$ n’est pas un multiple de $6$ ; $30$ = $6$ × $5$."
