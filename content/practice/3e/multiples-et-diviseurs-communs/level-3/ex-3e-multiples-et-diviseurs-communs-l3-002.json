  "statement": {
    "content": "Deux roues dentées s’engrènent : l’une a $18$ dents, l’autre $27$. Un repère est marqué sur chaque roue ; au départ, les deux repères sont face à face."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Combien de dents ont défilé quand les repères sont de nouveau face à face pour la première fois ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "54",
      "answerFormat": "Un nombre de dents",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Le nombre de dents défilées est un multiple de $18$ ET de $27$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Écris les multiples de $27$ et cherche le premier qui est un multiple de $18$."
        }
      ],
      "feedback": {
        "correct": "$54$ = $18$ × $3$ = $27$ × $2$.",
        "incorrect": "Cherche le plus petit multiple commun non nul de $18$ et de $27$."
      },
      "solution": {
        "lines": [
          "Multiples de $27$ : $27$, $54$.",
          "$27$ n’est pas un multiple de $18$ ; $54$ = $18$ × $3$."
        ],
        "result": "54"
      },
