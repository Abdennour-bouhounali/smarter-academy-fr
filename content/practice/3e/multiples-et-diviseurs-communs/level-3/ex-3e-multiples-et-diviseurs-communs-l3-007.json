  "statement": {
    "content": "Un phare émet un éclat toutes les $15$ s, un autre toutes les $18$ s. À $21$ h $0$ min $0$ s, ils éclatent ensemble."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Au bout de combien de secondes éclatent-ils ensemble pour la première fois après $21$ h ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "90",
      "answerFormat": "Un nombre de secondes",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Écris les multiples de $18$ jusqu’à ce que l’un soit un multiple de $15$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$18$, $36$, $54$, $72$, $90$…"
        }
      ],
      "feedback": {
        "correct": "$90$ = $15$ × $6$ = $18$ × $5$.",
        "incorrect": "Cherche le plus petit multiple commun non nul de $15$ et de $18$."
      },
      "solution": {
        "lines": [
          "Multiples de $18$ : $18$, $36$, $54$, $72$, $90$.",
          "Seul $90$ est aussi un multiple de $15$ ($15$ × $6$)."
        ],
        "result": "90"
      },
