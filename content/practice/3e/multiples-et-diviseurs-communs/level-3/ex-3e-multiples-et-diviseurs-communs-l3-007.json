    {
      "id": "q2",
      "step": "02",
      "statement": "À $21$ h $1$ min, à quelle seconde de la minute éclatent-ils ensemble ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "30",
      "answerFormat": "Une seconde entre $0$ et $59$",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$90$ s, c’est $1$ minute et encore …"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$90$ − $60$."
        }
      ],
      "feedback": {
        "correct": "$90$ s = $1$ min $30$ s : à $21$ h $1$ min $30$ s.",
        "incorrect": "Convertis $90$ s en minutes et secondes."
      },
      "solution": {
        "lines": [
          "$90$ s = $60$ s + $30$ s = $1$ min $30$ s."
        ],
