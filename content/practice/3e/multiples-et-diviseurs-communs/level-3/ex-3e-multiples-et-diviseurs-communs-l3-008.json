    {
      "id": "q2",
      "step": "02",
      "statement": "Combien de fois repartent-elles ensemble entre $6$ h exclu et $13$ h inclus ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "2",
      "answerFormat": "Un nombre entier",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "De $6$ h à $13$ h, il s’écoule $7$ heures : combien de minutes ?"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Combien de multiples de $168$ jusqu’à cette durée ?"
        }
      ],
      "feedback": {
        "correct": "$7$ h = $420$ min et $2$ × $168$ = $336$ ≤ $420$ < $3$ × $168$.",
        "incorrect": "Convertis la durée en minutes puis compte les multiples de $168$ qu’elle contient."
      },
      "solution": {
        "lines": [
          "De $6$ h à $13$ h : $7$ h = $420$ min.",
          "$420$ ÷ $168$ = $2{,}5$ : il y a $2$ multiples de $168$ avant $420$.",
          "Rendez-vous à $168$ et $336$ min."
        ],
        "result": "2"
      },
