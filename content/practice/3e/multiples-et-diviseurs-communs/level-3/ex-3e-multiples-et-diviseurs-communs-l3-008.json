  "statement": {
    "content": "Deux lignes de bus partent ensemble du dépôt à $6$ h. La ligne A repart toutes les $24$ min, la ligne B toutes les $28$ min."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Au bout de combien de minutes repartent-elles ensemble pour la première fois ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "168",
      "answerFormat": "Un nombre de minutes",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Décompose $24$ et $28$ en facteurs premiers."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$24$ = $2^{3} \\times 3$ et $28$ = $2^{2} \\times 7$ : garde chaque nombre premier avec son plus grand exposant."
        }
      ],
      "feedback": {
        "correct": "$2^{3} \\times 3 \\times 7 = 168$.",
        "incorrect": "Décompose $24$ et $28$, puis garde chaque nombre premier avec son plus grand exposant."
      },
      "solution": {
        "lines": [
          "$24$ = $2^{3} \\times 3$ et $28$ = $2^{2} \\times 7$.",
          "Plus petit multiple commun : $2^{3} \\times 3 \\times 7 = 168$."
        ],
        "result": "168"
      },
