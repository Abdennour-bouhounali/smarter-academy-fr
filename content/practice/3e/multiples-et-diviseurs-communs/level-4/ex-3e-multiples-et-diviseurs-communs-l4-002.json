  "statement": {
    "content": "Trois lignes de bus partent ensemble de la gare à $6$ h. La ligne A repart toutes les $7$ min, la ligne B toutes les $9$ min, la ligne C toutes les $10$ min."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Au bout de combien de minutes les trois lignes repartent-elles ensemble pour la première fois ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "630",
      "answerFormat": "Un nombre de minutes",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$7$, $9$ et $10$ sont premiers deux à deux : ils n’ont aucun facteur premier en commun."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Aucun facteur n’est compté deux fois."
        }
      ],
      "feedback": {
        "correct": "$7$ × $9$ × $10$ = $630$ : ici le produit est le plus petit multiple commun.",
        "incorrect": "Écris les décompositions : $7$, $3^{2}$ et $2 \\times 5$."
      },
      "solution": {
        "lines": [
          "$7$ est premier, $9$ = $3^{2}$, $10$ = $2 \\times 5$ : aucun nombre premier en commun.",
          "Plus petit multiple commun : $7 \\times 3^{2} \\times 2 \\times 5 = 630$."
        ],
        "result": "630"
      },
      "timeSeconds": 90
