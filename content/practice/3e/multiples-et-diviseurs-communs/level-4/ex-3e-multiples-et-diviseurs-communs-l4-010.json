      "step": "01",
      "statement": "Écris le plus petit multiple commun non nul de $66$ et de $90$ sous la forme d’un produit de facteurs premiers.",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "factorization",
      "expectedAnswer": "2*3^2*5*11",
      "answerFormat": "Un produit de nombres premiers : tape × (ou *) entre les facteurs, ^ pour un exposant",
