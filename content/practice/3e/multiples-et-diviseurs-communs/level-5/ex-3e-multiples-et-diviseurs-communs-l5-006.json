    {
      "id": "q2",
      "step": "02",
      "statement": "Combien coûtent les planches d’un tronçon, en euros ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "19",
      "answerFormat": "Un nombre entier d’euros",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Planches de A : $135$ ÷ $27$. Planches de B : $135$ ÷ $45$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Multiplie chaque nombre de planches par son prix et additionne."
        }
      ],
      "feedback": {
        "correct": "$5$ × $2$ + $3$ × $3$ = $19$.",
        "incorrect": "Compte les planches de chaque équipe, multiplie par le prix, puis additionne."
      },
      "solution": {
        "lines": [
          "A : $135$ ÷ $27$ = $5$ planches, soit $5$ × $2$ = $10$ €.",
          "B : $135$ ÷ $45$ = $3$ planches, soit $3$ × $3$ = $9$ €.",
          "Total : $10$ + $9$ = $19$ €."
        ],
        "result": "19"
      },
      "timeSeconds": 120
    },
    {
