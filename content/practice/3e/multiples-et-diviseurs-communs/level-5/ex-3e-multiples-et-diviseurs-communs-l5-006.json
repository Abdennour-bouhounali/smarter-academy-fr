  "statement": {
    "content": "Deux équipes bâtissent une passerelle à partir de la même rive. L’équipe A pose des planches de $27$ cm à $2$ € pièce, l’équipe B des planches de $45$ cm à $3$ € pièce. On pose un pilier chaque fois que les deux équipes finissent une planche entière en même temps ; le budget total est de $100$ €."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "Quelle est la longueur d’un tronçon entre la rive (ou un pilier) et le pilier suivant, en centimètres ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "135",
      "answerFormat": "Un nombre de centimètres",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$27$ = $3^{3}$ et $45$ = $3^{2} \\times 5$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Plus petit multiple commun non nul."
        }
      ],
      "feedback": {
        "correct": "$3^{3} \\times 5 = 135$.",
        "incorrect": "La longueur est un multiple de $27$ ET de $45$ : cherche le plus petit non nul."
      },
      "solution": {
        "lines": [
          "$27$ = $3^{3}$ et $45$ = $3^{2} \\times 5$.",
          "Plus petit multiple commun : $3^{3} \\times 5 = 135$."
        ],
        "result": "135"
      },
