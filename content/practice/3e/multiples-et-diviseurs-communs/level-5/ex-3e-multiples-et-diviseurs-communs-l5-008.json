          "id": "h1",
          "type": "look",
          "content": "$50$ = $2 \\times 5^{2}$ et $15$ = $3 \\times 5$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Chaque nombre premier avec son plus grand exposant."
        }
      ],
      "feedback": {
        "correct": "$2 \\times 3 \\times 5^{2} = 150$.",
