  "statement": {
    "content": "Deux équipes bâtissent une même passerelle à partir de la rive. L’équipe rouge pose des planches de $45$ cm à $3$ € pièce, l’équipe bleue des planches de $50$ cm à $4$ € pièce. Un pilier ne peut être posé qu’à un endroit où les deux équipes finissent une planche entière."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "À quelle distance de la rive se trouve le premier pilier possible ?",
      "learningPoints": [
        {
          "code": "3e_multiples-et-diviseurs-communs_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "expectedAnswer": "450",
      "answerFormat": "Un nombre de centimètres",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$45$ = $3^{2} \\times 5$ et $50$ = $2 \\times 5^{2}$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Plus petit multiple commun non nul."
        }
      ],
      "feedback": {
        "correct": "$2 \\times 3^{2} \\times 5^{2} = 450$.",
        "incorrect": "La distance est un multiple de $45$ ET de $50$ : cherche le plus petit non nul."
      },
      "solution": {
        "lines": [
          "$45$ = $3^{2} \\times 5$ et $50$ = $2 \\times 5^{2}$.",
          "Plus petit multiple commun : $2 \\times 3^{2} \\times 5^{2} = 450$."
        ],
        "result": "450"
