        {
          "id": "h2",
          "type": "direction",
          "content": "Compte tous les facteurs $2$, puis tous les facteurs $3$."
        }
      ],
      "feedback": {
        "correct": "$5\\,040 = 2^4 \\times 3^2 \\times 5 \\times 7$.",
        "incorrect": "Remplace $4$ et $6$ par leurs décompositions, puis regroupe les facteurs identiques.",
        "notPrime": "Ton produit vaut bien $5\\,040$, mais un de ses facteurs n’est pas premier : décompose-le à son tour.",
        "wrongExponents": "Ce sont les bons nombres premiers, mais ton produit ne vaut pas $5\\,040$ : recompte combien de fois chacun divise.",
        "wrongProduct": "Ton produit ne vaut pas $5\\,040$ : reprends les divisions une par une.",
        "powersExpected": "C’est juste, mais écris chaque facteur premier une seule fois, avec son exposant."
