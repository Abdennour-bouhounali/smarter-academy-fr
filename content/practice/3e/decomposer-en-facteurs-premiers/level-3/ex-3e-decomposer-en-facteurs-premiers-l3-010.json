      ],
      "feedback": {
        "correct": "$2\\,964 = 2^2 \\times 3 \\times 13 \\times 19$.",
        "incorrect": "Divise par $2$, puis par $3$, puis continue les essais sur le quotient sans t’arrêter au premier échec.",
        "notPrime": "Ton produit vaut bien $2\\,964$, mais un de ses facteurs n’est pas premier : décompose-le à son tour.",
        "wrongExponents": "Ce sont les bons nombres premiers, mais ton produit ne vaut pas $2\\,964$ : recompte combien de fois chacun divise.",
        "wrongProduct": "Ton produit ne vaut pas $2\\,964$ : reprends les divisions une par une."
      },
      "solution": {
        "lines": [
          "$2\\,964 \\div 2 = 1\\,482$",
          "$1\\,482 \\div 2 = 741$",
          "$741 \\div 3 = 247$",
          "$247 \\div 13 = 19$",
          "$19 \\div 19 = 1$",
          "Donc $2\\,964 = 2 \\times 2 \\times 3 \\times 13 \\times 19 = 2^2 \\times 3 \\times 13 \\times 19$."
        ],
        "result": "2\\,964 = 2^2 \\times 3 \\times 13 \\times 19"
