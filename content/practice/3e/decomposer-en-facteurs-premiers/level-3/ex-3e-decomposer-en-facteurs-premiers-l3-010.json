      "answerType": "factorization",
      "answerFormat": "Un produit de nombres premiers : tape × (ou *) entre les facteurs",
      "expectedAnswer": "2^2*3*13*19",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "Divise par $2$ tant que c’est possible."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Puis essaie $3$, et regarde si le quotient $247$ se divise par $13$."
