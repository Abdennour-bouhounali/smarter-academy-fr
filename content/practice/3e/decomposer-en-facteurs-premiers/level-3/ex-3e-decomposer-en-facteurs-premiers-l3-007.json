    {
      "id": "q2",
      "step": "02",
      "statement": "Montre que $15$ divise $N$ en écrivant $N = 15 \\times q$. Que vaut le nombre entier $q$ ?",
      "learningPoints": [
        {
          "code": "3e_decomposer-en-facteurs-premiers_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "Un nombre entier",
      "expectedAnswer": "40",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$15 = 3 \\times 5$ : retrouve ces deux facteurs dans l’écriture de $N$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "Regroupe : $N = (3 \\times 5) \\times (\\ldots)$."
        }
      ],
      "feedback": {
        "correct": "$N = (3 \\times 5) \\times (2^3 \\times 5) = 15 \\times 40$.",
        "incorrect": "Mets de côté un facteur $3$ et un facteur $5$ ; les facteurs qui restent forment $q$."
      },
      "solution": {
        "lines": [
          "$N = 2^3 \\times 3 \\times 5 \\times 5 = (3 \\times 5) \\times (2^3 \\times 5)$",
          "$N = 15 \\times 40$ : $15$ divise $N$ et $q = 40$."
        ],
        "result": "q = 40"
      },
      "work": "optional",
      "timeSeconds": 90
    },
